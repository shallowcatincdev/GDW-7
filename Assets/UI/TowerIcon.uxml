<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; background-color: rgba(55, 55, 55, 0.624); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; border-left-color: rgba(55, 55, 55, 0.702); border-right-color: rgba(55, 55, 55, 0.702); border-top-color: rgba(55, 55, 55, 0.702); border-bottom-color: rgba(55, 55, 55, 0.702); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px;">
        <ui:Label text="Tower Name" style="align-items: flex-start; align-self: center; font-size: 25px; -unity-font-style: bold; -unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-text-outline-color: rgb(111, 111, 111); -unity-text-outline-width: 1px; height: 10%; -unity-text-auto-size: best-fit 10px 100px;"/>
        <ui:Image source="project://database/Assets/UI/TestImage300x300.png?fileID=2800000&amp;guid=beca7ec93c0956b48a9ade2375364fea&amp;type=3#TestImage300x300" style="height: 75%;"/>
        <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: space-between; height: 15%;">
            <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                <ui:Image source="project://database/Assets/UI/CoinTestImage.png?fileID=2800000&amp;guid=b504be56fd3061744be50ce76423eeac&amp;type=3#CoinTestImage" scale-mode="ScaleToFit" style="aspect-ratio: 1; margin-left: 5px; margin-top: 5px;"/>
                <ui:Label text="100" style="-unity-text-align: middle-left; -unity-font-style: bold; font-size: 25px; color: rgb(255, 255, 255); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(111, 111, 111); margin-left: 5px; -unity-text-auto-size: best-fit 10px 100px;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; align-items: stretch; flex-direction: row; justify-content: flex-end;">
                <ui:Label text="Tower Class?" style="-unity-text-align: middle-right; -unity-font-style: bold; font-size: 25px; color: rgb(255, 255, 255); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(111, 111, 111); -unity-text-auto-size: best-fit 10px 100px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
